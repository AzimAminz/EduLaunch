    }
    ADMISSION_STAT {
        ​PK stat_id
        ​FK program_id
        ​ intake_year
        ​ lowest_merit
        ​ average_merit
        ​ applicants
        ​ places
    }
    ACCOUNT {
        ​PK account_id
    }
    FIELD {
        ​PK field_id
