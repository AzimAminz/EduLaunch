<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. During development the backend runs on this computer, which the app reaches over the local
    network (10.0.2.2 from the emulator, the computer's address from a real phone). From Android 17 an app needs this
    permission for that. Android Studio grants it when it installs the app (see installOptions in build.gradle.kts).
    Release builds talk to the EduLaunch server on the internet and do not need it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
</manifest>
