<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Cuba lagi" on the offline screen checks whether the phone is back online. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Edulaunch">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Accounts and onboarding (Figma section 2 · Mula & akaun). -->
        <activity
            android:name=".auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.CheckInboxActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".home.HomeActivity"
            android:exported="false" />

        <!-- Profile pages (Figma section 3 · Utama & profil); all shown by FeaturePageActivity. -->
        <activity
            android:name=".home.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".home.SavedActivity"
            android:exported="false" />
        <activity
            android:name=".home.UpdatesActivity"
            android:exported="false" />
        <activity
            android:name=".home.PrivacyActivity"
            android:exported="false" />
        <activity
            android:name=".home.HelpActivity"
            android:exported="false" />

        <!-- Academic profile by level (Figma section 3.1 · Profil akademik ikut tahap). -->
        <activity
            android:name=".home.AcademicProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 4 · Teroka program -->
        <activity
            android:name=".explore.ExploreActivity"
            android:exported="false" />
        <activity
            android:name=".explore.ProgramSearchActivity"
            android:exported="false" />
        <activity
            android:name=".explore.ProgramDetailActivity"
            android:exported="false" />
        <activity
            android:name=".explore.CompareActivity"
            android:exported="false" />
        <activity
            android:name=".explore.RecommendationsActivity"
            android:exported="false" />
        <activity
            android:name=".explore.UniversityActivity"
            android:exported="false" />
        <activity
            android:name=".explore.EvidenceActivity"
            android:exported="false" />

        <!-- 5 · Kelayakan & Merit Lab -->
        <activity
            android:name=".merit.EligibilityActivity"
            android:exported="false" />
        <activity
            android:name=".merit.MeritLabActivity"
            android:exported="false" />

        <!-- 6 · Kenali diri -->
        <activity
            android:name=".discover.QuizActivity"
            android:exported="false" />
        <activity
            android:name=".discover.DiscoveringActivity"
            android:exported="false" />
        <activity
            android:name=".discover.InterestResultActivity"
            android:exported="false" />
        <activity
            android:name=".discover.FieldDiscoveryActivity"
            android:exported="false" />
        <activity
            android:name=".discover.ExperienceActivity"
            android:exported="false" />
        <activity
            android:name=".discover.ReflectionActivity"
            android:exported="false" />
        <activity
            android:name=".discover.NextOptionsActivity"
            android:exported="false" />

        <!-- 7 · Roadmap -->
        <activity
            android:name=".roadmap.RoadmapActivity"
            android:exported="false" />
        <activity
            android:name=".roadmap.BuildRoadmapActivity"
            android:exported="false" />
        <activity
            android:name=".roadmap.GeneratingRoadmapActivity"
            android:exported="false" />
        <activity
            android:name=".roadmap.RoadmapVersionsActivity"
            android:exported="false" />
        <activity
            android:name=".roadmap.RoadmapSavedActivity"
            android:exported="false" />

        <!-- 8 · Dokumen akademik -->
        <activity
            android:name=".documents.DocumentsActivity"
            android:exported="false" />
        <activity
            android:name=".documents.SelectedDocumentActivity"
            android:exported="false" />
        <activity
            android:name=".documents.ReviewReadingActivity"
            android:exported="false" />
        <activity
            android:name=".documents.ResultsSavedActivity"
            android:exported="false" />
        <activity
            android:name=".documents.ResultEntryActivity"
            android:exported="false" />
        <activity
            android:name=".documents.UnreadableFileActivity"
            android:exported="false" />

        <!-- 9 · Tanya AI bersumber -->
        <activity
            android:name=".ai.AskAiActivity"
            android:exported="false" />
        <activity
            android:name=".ai.AiBusyActivity"
            android:exported="false" />

        <!-- 10 · Keadaan sistem -->
        <activity
            android:name=".system.RequestFailedActivity"
            android:exported="false" />
        <activity
            android:name=".system.SessionExpiredActivity"
            android:exported="false" />
        <activity
            android:name=".system.OfflineActivity"
            android:exported="false" />

        <!-- Keeps the chosen language across restarts on Android 12 and older (13+ keeps it itself). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
