<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Subjek teras" / "Gred STPM": the subjects taken, each with its grade, then "+ Tambah subjek". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:background="@drawable/bg_card_form"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:accessibilityHeading="true"
        android:fontFamily="@font/outfit_semibold"
        android:textColor="@color/navy"
        android:textSize="17sp"
        tools:targetApi="p"
        tools:text="Subjek yang anda ambil" />

    <TextView
        android:id="@+id/card_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:textColor="@color/muted"
        android:textSize="13sp"
        tools:text="Buang yang tidak diambil, tambah yang belum ada. Skala gred: A–F." />

    <!-- Column names when there is a target column (Form 4–5). -->
    <LinearLayout
        android:id="@+id/columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/outfit_semibold"
            android:text="@string/subject_head"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/outfit_semibold"
            android:text="@string/subject_head_current"
            android:textColor="@color/muted"
            android:textSize="10sp"
            tools:ignore="SmallSp" />

        <TextView
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/outfit_semibold"
            android:text="@string/subject_head_target"
            android:textColor="@color/muted"
            android:textSize="10sp"
            tools:ignore="SmallSp" />

        <Space
            android:layout_width="40dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/button_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_add_dashed"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/outfit_semibold"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:minHeight="48dp"
        android:padding="14dp"
        android:text="@string/subject_add"
        android:textColor="@color/navy"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/subject_add_hint"
        android:textColor="@color/muted"
        android:textSize="13sp" />
</LinearLayout>
