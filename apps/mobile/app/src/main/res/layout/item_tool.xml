<?xml version="1.0" encoding="utf-8"?>
<!-- One tool in the "Semua alat" sheet (Alat / …): an icon in a white square, an optional count, and its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_tool_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <!-- The count sits on the icon's top-right corner, 6dp above it. -->
    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="50dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/bg_tool_icon">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_tool_columns" />
        </FrameLayout>

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="14dp"
            android:layout_marginStart="48dp"
            android:background="@drawable/bg_pill_yellow"
            android:fontFamily="@font/outfit_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/navy"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="2/3"
            tools:visibility="visible" />
    </FrameLayout>

    <TextView
        android:id="@+id/name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_medium"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/navy"
        android:textSize="13sp"
        tools:text="Banding" />
</LinearLayout>
