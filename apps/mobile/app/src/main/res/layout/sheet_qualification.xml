<?xml version="1.0" encoding="utf-8"?>
<!-- M / Onboarding · Helaian pilih kelayakan: which qualification, for the two levels after SPM. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:fontFamily="@font/outfit_bold"
            android:text="@string/level_sheet_title"
            android:textColor="@color/navy"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/outfit_semibold"
            android:text="@string/level_sheet_question"
            android:textColor="@color/navy"
            android:textSize="15sp" />

        <!-- One row per qualification, added by OnboardingActivity. -->
        <LinearLayout
            android:id="@+id/qualification_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/level_sheet_hint"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_confirm"
            style="@style/Edulaunch.Button"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:text="@string/level_sheet_confirm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Edulaunch.Button.Outlined"
            android:text="@string/level_sheet_cancel" />
    </LinearLayout>
</ScrollView>
