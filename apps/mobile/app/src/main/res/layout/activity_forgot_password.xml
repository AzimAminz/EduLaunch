<?xml version="1.0" encoding="utf-8"?>
<!-- M / Pulihkan akses akaun: ask for a recovery link by e-mail. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    tools:context=".auth.ForgotPasswordActivity">

    <LinearLayout style="@style/Edulaunch.Screen">

        <include layout="@layout/view_header" />

        <TextView
            style="@style/Edulaunch.Eyebrow"
            android:text="@string/forgot_eyebrow" />

        <TextView
            style="@style/Edulaunch.Title"
            android:text="@string/forgot_title" />

        <TextView
            style="@style/Edulaunch.Body"
            android:text="@string/forgot_intro" />

        <ImageView
            style="@style/Edulaunch.Panel"
            android:contentDescription="@string/forgot_mascot"
            android:src="@drawable/rimau_shield" />

        <TextView
            style="@style/Edulaunch.FieldLabel"
            android:labelFor="@+id/input_email"
            android:text="@string/auth_email" />

        <EditText
            android:id="@+id/input_email"
            style="@style/Edulaunch.Field"
            android:autofillHints="emailAddress"
            android:hint="@string/auth_email_placeholder"
            android:imeOptions="actionSend"
            android:inputType="textEmailAddress" />

        <TextView
            android:id="@+id/error_email"
            style="@style/Edulaunch.FieldError" />

        <LinearLayout style="@style/Edulaunch.Card">

            <TextView
                style="@style/Edulaunch.CardTitle"
                android:text="@string/forgot_after_title" />

            <TextView
                style="@style/Edulaunch.Body"
                android:layout_marginTop="6dp"
                android:text="@string/forgot_after_body" />
        </LinearLayout>

        <TextView
            android:id="@+id/form_alert"
            style="@style/Edulaunch.FormAlert" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_send"
            style="@style/Edulaunch.Button"
            android:layout_marginTop="22dp"
            android:text="@string/forgot_submit"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="textEnd" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_back"
            style="@style/Edulaunch.Button.Outlined"
            android:text="@string/forgot_back"
            app:icon="@drawable/ic_log_in" />
    </LinearLayout>
</ScrollView>
