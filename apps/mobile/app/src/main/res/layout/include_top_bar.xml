<?xml version="1.0" encoding="utf-8"?>
<!--
    Top bar (Figma: Mobile / Bar atas, signed in): logo, search, notifications, profile.
    Shared by every signed-in screen; AppChrome.kt wires the buttons.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp">

    <ImageView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_logo" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_bold"
        android:maxLines="1"
        android:text="@string/app_name"
        android:textColor="@color/navy"
        android:textSize="23sp" />

    <FrameLayout
        android:id="@+id/button_search"
        style="@style/Edulaunch.TopButton"
        android:layout_marginStart="0dp"
        android:contentDescription="@string/home_search">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/button_notifications"
        style="@style/Edulaunch.TopButton"
        android:clipChildren="false"
        android:contentDescription="@string/home_notifications">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bell" />

        <TextView
            android:id="@+id/notifications_badge"
            android:layout_width="wrap_content"
            android:layout_height="15dp"
            android:layout_marginStart="23dp"
            android:layout_marginTop="-3dp"
            android:background="@drawable/bg_badge"
            android:fontFamily="@font/outfit_bold"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:minWidth="15dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            tools:text="3" />
    </FrameLayout>

    <TextView
        android:id="@+id/button_profile"
        style="@style/Edulaunch.TopButton"
        android:background="@drawable/bg_avatar"
        android:contentDescription="@string/home_profile"
        android:fontFamily="@font/outfit_semibold"
        android:gravity="center"
        android:textColor="@color/navy"
        android:textSize="14sp"
        tools:text="NA" />
</LinearLayout>
