<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "M / Kemas kini tahap pendidikan · helaian": a Form 4–5 student says whether SPM results are out. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:id="@+id/chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill_yellow"
            android:fontFamily="@font/outfit_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/navy"
            android:textSize="13sp"
            tools:text="Keputusan SPM 2026 telah diumumkan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityHeading="true"
            android:fontFamily="@font/outfit_bold"
            android:text="@string/level_update_title"
            android:textColor="@color/navy"
            android:textSize="24sp"
            tools:targetApi="p" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/level_update_body"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <!-- Three answers (item_qualification_option), added from code. -->
        <LinearLayout
            android:id="@+id/options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_note_blue"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_bold"
                android:importantForAccessibility="no"
                android:text="i"
                android:textColor="@color/navy"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/level_update_note"
                android:textColor="@color/navy"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_continue"
            style="@style/Edulaunch.Button"
            android:layout_marginTop="14dp"
            android:enabled="false"
            android:text="@string/level_update_continue"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconGravity="textEnd" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_later"
            style="@style/Edulaunch.Button.Outlined"
            android:layout_marginTop="14dp"
            android:text="@string/level_update_later"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_clock" />
    </LinearLayout>
</ScrollView>
