{
  "name": "edulaunch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "bootstrap": "node tools/scripts/bootstrap.mjs",
    "doctor": "node tools/scripts/bootstrap.mjs --check",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "infra:up": "docker compose -f infra/docker/compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/compose.yml down",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "env:setup": "node tools/scripts/setup-env.mjs",
    "admin:grant": "node tools/scripts/make-admin.mjs"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^6.0.2"
  }
}
